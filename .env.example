# Required administrator credentials. ADMIN_PASSWORD must contain at least 12 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# Required: at least 32 random characters. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters

# Required: exactly 32 random bytes encoded as base64. Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Backend HTTP and SQLite. Compose overrides these two values for the container.
BIND_ADDR=127.0.0.1:3001
DATABASE_PATH=/data/kiro.db

# Browser security. Keep true behind HTTPS. Leave ALLOWED_ORIGIN empty for strict same-origin only.
COOKIE_SECURE=true
ALLOWED_ORIGIN=
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Compose pins its internal bridge so only the host-side Nginx gateway is trusted for forwarded IP headers.
KIRO_DOCKER_SUBNET=172.29.0.0/24
KIRO_DOCKER_GATEWAY=172.29.0.1

# Kiro API Gateway uses a credential completely separate from administrator login.
GATEWAY_ENABLED=true
GATEWAY_API_KEY=replace-with-an-independent-random-key-at-least-32-characters
GATEWAY_DEFAULT_ACCOUNT=
GATEWAY_AUTO_SWITCH=true

# Public user panel. Disable to stop new registrations while keeping existing users active.
USER_REGISTRATION_ENABLED=true

# Structured Rust logs. Never enable request-body/header debug logging in production.
RUST_LOG=kiro_web_backend=info,tower_http=info
