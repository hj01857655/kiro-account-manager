{
  "name": "kiro-account-manager-web",
  "private": true,
  "version": "0.1.0",
  "description": "Linux-deployable web management panel for Kiro accounts",
  "license": "CC-BY-NC-SA-4.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/hj01857655/kiro-account-manager"
  },
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "install:frontend": "npm --prefix frontend ci",
    "test:backend": "cargo test --manifest-path backend/Cargo.toml",
    "clippy:backend": "cargo clippy --manifest-path backend/Cargo.toml --all-targets -- -D warnings"
  }
}
